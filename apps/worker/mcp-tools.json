[
  {
    "name": "drive_write",
    "title": "Write file",
    "description": "Write a markdown file to a workspace. Creates or updates the file with automatic versioning.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string",
          "description": "Workspace ID to write to"
        },
        "path": {
          "type": "string",
          "description": "File path (e.g. \"notes/meeting.md\")"
        },
        "content": {
          "type": "string",
          "description": "File content (markdown)"
        },
        "message": {
          "description": "Optional version message",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "path",
        "content"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Write file",
      "readOnlyHint": false,
      "destructiveHint": true
    }
  },
