  {
    "name": "drive_share",
    "title": "Create share link",
    "description": "Generate a share link for a workspace or specific file. Optionally email-gate the link so only a specific person can access it. Humans open this link to view, comment, or edit files.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string",
          "description": "Workspace ID"
        },
        "permission": {
          "type": "string",
          "enum": [
            "view",
            "comment",
            "edit"
          ],
          "description": "Permission level for the share link"
        },
        "file_id": {
          "description": "Scope to a specific file (optional)",
          "type": "string"
        },
        "expires_in": {
          "description": "Expiry in seconds (optional)",
          "type": "number"
        },
        "max_uses": {
          "description": "Maximum number of uses (optional)",
          "type": "number"
        },
        "email": {
          "description": "Email-gate: only this email can access the link (requires email verification). Leave empty for public access.",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "permission"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "Create share link",
      "readOnlyHint": false,
      "destructiveHint": false
    }
  },
