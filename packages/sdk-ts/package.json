{
  "name": "@adrive/sdk",
  "version": "1.0.1",
  "description": "TypeScript SDK for AgentDrive — cross-agent artifact workspace with provenance, semantic recall, and portable storage.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "homepage": "https://agentdrive.sh",
  "bugs": {
    "url": "https://github.com/agentdrive-sh/agentdrive-mcp/issues"
  },
  "keywords": [
    "agentdrive",
    "agent",
    "ai-agent",
    "mcp",
    "sdk",
    "typescript",
    "claude-code",
    "codex",
    "cursor",
    "langgraph"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\" && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
